[Unit]

{% if item.value.depend is defined %}
After={{ item.value.depend }}
Requires={{ item.value.depend }}
{% endif %}

[Container]
Image={{ item.value.image }}{% if item.value.tag is defined %}:{{ item.value.tag }}{% endif %}

Pull=newer

{% if item.value.exec is defined %}
Exec={{ item.value.exec | split('\n') | join(' ') }}
{% endif %}

{% if item.value.volumes is defined %}
{% for volume in item.value.volumes %}
Volume={{ volume }}
{% endfor %}
{% endif %}

{% if item.value.tmpfs is defined %}
{% for tmpfs in item.value.tmpfs %}
Tmpfs={{ tmpfs }}
{% endfor %}
{% endif %}

{% if item.value.shm_size is defined %}
ShmSize={{ item.value.shm_size }}
{% endif %}

{% if item.value.devices is defined %}
{% for device in item.value.devices %}
AddDevice={{ device }}
{% endfor %}
{% endif %}

{% if item.value.groupadds is defined %}
{% for group in item.value.groupadds %}
GroupAdd={{ group }}
{% endfor %}
{% endif %}

{% if item.value.network is defined %}
Network={{ item.value.network }}
{% endif %}

{% if item.value.network_alias is defined %}
{% for alias in ([item.value.network_alias] if item.value.network_alias is string else item.value.network_alias) %}
NetworkAlias={{ alias }}
{% endfor %}
{% endif %}

{% for cap in item.value.get('cap_add', []) %}
AddCapability={{ cap }}
{% endfor %}

{% for cap in item.value.get('cap_drop', []) %}
DropCapability={{ cap }}
{% endfor %}

{% for rule, value in item.value.get('sysctls', {}).items() %}
Sysctl={{ rule }}={{ value }}
{% endfor %}

{% if item.value.ports is defined %}
{% for port in item.value.ports %}
PublishPort={{ port }}
{% endfor %}
{% endif %}

{% if item.value.env is defined %}
{% for env_key, env_value in item.value.env.items() %}
Environment={{ env_key }}="{{ env_value }}"
{% endfor %}
{% endif %}

{% if item.value.env_file is defined %}
EnvironmentFile={{ item.value.env_file }}
{% endif %}

{% if item.value.entrypoint is defined %}
Entrypoint={{ item.value.entrypoint }}
{% endif %}

{% if item.value.user is defined %}
User={{ item.value.user }}
{% endif %}

{% if item.value.podman is defined %}
PodmanArgs={{ item.value.podman }}
{% endif %}


[Service]

{% if item.value.restart is not defined %}
Restart=always
{% else %}
Restart={{ item.value.restart }}
{% endif %}
{% if item.value.memory_max is defined %}
MemoryMax={{ item.value.memory_max }}
{% endif %}
{% if item.value.memory_high is defined %}
MemoryHigh={{ item.value.memory_high }}
{% endif %}
{% if item.value.memory_swap_max is defined %}
MemorySwapMax={{ item.value.memory_swap_max }}
{% endif %}
{% if item.value.exec_pre is defined %}
ExecStartPre=/bin/bash -c "{{ item.value.exec_pre | split('\n') | join(' ') | replace ('"', '\\"') }}"
{% endif %}
RestartSec=5s
StartLimitBurst=15
StartLimitInterval=5m
TimeoutStartSec={{ item.value.start_timeout | default(300) }}

{% if item.value.enabled | default(true) %}
[Install]
WantedBy=default.target
{% endif %}
