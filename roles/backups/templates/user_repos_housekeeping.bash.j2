if [ -f {{ backups_secrets_file }} ]; then
  source {{ backups_secrets_file }}
fi

send_webhook() {
  if [ -z "$WEBHOOK_URL" ]; then
    return
  fi

  {% raw %}
  local msg="$(printf '%b' "$*")"
  while [ ${#msg} -gt 0 ]; do
    part="${msg:0:1900}"
    curl -X POST -H 'Content-type: application/json' \
      -d "$(jq -n --arg m "$part" '{content: $m}')" \
      "$WEBHOOK_URL"
    msg="${msg:1900}"
  done
  {% endraw %}
}

logmsg() {
  echo -e "$@"
  send_webhook "$@"
}

export BORG_RELOCATED_REPO_ACCESS_IS_OK=yes
housekeeping_status=0

{% for repo in backups_repos %}

{% set keep = repo.get('keep', backup_repos_keep_defaults) %}

(
check_output=$(borg check "{{ repo.path }}" 2>&1)
check_status=$?
if (( check_status != 0 )); then
  logmsg "borg check failed (status=$check_status) for {{ repo.path }}, remaining housekeeping skipped:\n"'```'"\n$(tail -c 1500 <<< "$check_output")\n"'```'
  exit "$check_status"
fi

prune_output=$(
  borg prune --list --stats \
  {% if repo.get('dry_run', False) %}--dry-run{% endif %} \
  {% for period, value in keep.items() %}
  --keep-{{ period }} "{{ value }}" \
  {% endfor %}
  "{{ repo.path }}" 2>&1
)
prune_status=$?
echo "$prune_output"
if (( prune_status != 0 )); then
  logmsg "borg prune failed (status=$prune_status) for {{ repo.path }}, remaining housekeeping skipped:\n"'```'"\n$prune_output\n"'```'
  exit "$prune_status"
fi

deleted_archives=$(
  echo "$prune_output" \
  | grep -E "(Pruning archive|Would prune)" \
  | sed -E 's/^[^:]*:[[:space:]]*//' \
  | cut -d' ' -f1
)
if [ -n "$deleted_archives" ]; then
  {% if not repo.get('dry_run', False) %}
  {% set keep_label = keep.items() | map('join', '=') | join(', ') %}
  logmsg "borg prune ({{ keep_label }}) in {{ repo.path }}:\n"'```'"\n$prune_output\n"'```'
  {% endif %}

  {% if repo.get('dry_run', False) %}
  logmsg "Would delete archives in {{ repo.path }}:\n$deleted_archives"
  {% else %}
  logmsg "Deleted archives in {{ repo.path }}:\n$deleted_archives"
  {% endif %}

  kept_archives=$(
    echo "$prune_output" \
    | grep -E "(Keeping archive|Would keep)" \
    | sed 's/.*): *//' \
    | cut -d' ' -f1
  )
  if [ -n "$kept_archives" ]; then
    logmsg "Kept archives in {{ repo.path }}:\n$kept_archives"
  fi
fi

compact_output=$(
  borg compact {% if repo.get('dry_run', False) %}--dry-run{% endif %} \
  "{{ repo.path }}" 2>&1
)
compact_status=$?
echo "$compact_output"
if (( compact_status != 0 )); then
  logmsg "borg compact failed (status=$compact_status) for {{ repo.path }}, offsite sync skipped:\n"'```'"\n$compact_output\n"'```'
  exit "$compact_status"
fi

{% if repo.get('rclone_remote') %}
rclone_sync=$(
  borg with-lock --lock-wait 600 "{{ repo.path }}" \
  rclone sync -v \
  --exclude '/lock.exclusive/**' --exclude '/lock.roster' \
  {% if repo.get('dry_run', False) %}--dry-run{% endif %} \
  "{{ repo.path }}/" \
  "{{ repo.rclone_remote }}" 2>&1
)
transfer_status=$?
nothing_transferred="INFO  : There was nothing to transfer"
if (( transfer_status != 0 )) || ! echo "$rclone_sync" | grep -q "$nothing_transferred"; then
  echo "$rclone_sync"
  rclone_sync=$(
    echo "$rclone_sync" \
    | grep -v -E " (NOTICE:|INFO  :) "
  )
  send_webhook "rclone ({{ repo.rclone_remote }}, status=$transfer_status):\n"'```'"$rclone_sync"'\n```' >/dev/null
fi
exit "$transfer_status"
{% else %}
exit 0
{% endif %}
)
repository_status=$?
if (( repository_status != 0 )); then
  housekeeping_status=$repository_status
fi
{% endfor %}

exit "$housekeeping_status"
