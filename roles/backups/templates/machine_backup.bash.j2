logmsg() {
# get from stdin if no argument
if [ -z "$1" ]; then
    msg=""
    while IFS= read -r line; do
        printf '%s\n' "$line"
        msg+="$line"$'\n'
    done
    msg="${msg//\\n/$'\n'}"
else
    echo "$1"
    msg="$1"
fi

if [ -z "$WEBHOOK_URL" ]; then
    return
fi

msg="$(printf '%s\n' "$msg" | awk '
    { original = original $0 "\n" }
    $1 == "Repository:" {
        count = split(substr($0, 13), parts, "/")
        while (count > 1 && parts[count] == "") count--
        repository = parts[count]
        next
    }
    $1 == "Archive" && $2 == "name:" { name = substr($0, 15); next }
    $1 == "Duration:" { duration = substr($0, 11); next }
    $1 == "Number" && $2 == "of" && $3 == "files:" { files = substr($0, 18); next }
    $1 == "This" && $2 == "archive:" {
        size = $3 " " $4
        compressed = $5 " " $6
        deduplicated = $7 " " $8
        next
    }
    $1 == "All" && $2 == "archives:" {
        total_size = $3 " " $4
        total_compressed = $5 " " $6
        total_deduplicated = $7 " " $8
        next
    }
    index($0, "----------") == 1 { next }
    $1 == "Archive" && $2 == "fingerprint:" { next }
    $1 == "Time" && ($2 == "(start):" || $2 == "(end):") { next }
    index($0, "Utilization of max. archive size:") == 1 { next }
    $1 == "Chunk" && $2 == "index:" { next }
    $1 == "Original" && $2 == "size" { next }
    $1 == "Unique" && $2 == "chunks" { next }
    NF == 0 { next }
    { diagnostics = diagnostics $0 "\n" }
    END {
        if (repository == "" || name == "" || duration == "" || files == "" || size == "" || total_size == "") {
            printf "%s", original
            exit
        }
        printf "%s", diagnostics
        printf "Repository: %s\nName: %s\nDuration: %s\nNumber of files: %s\n", repository, name, duration, files
        printf "Size: %s / %s\n", size, total_size
        printf "Compressed size: %s / %s\n", compressed, total_compressed
        printf "Deduplicated size: %s / %s\n", deduplicated, total_deduplicated
    }
')"

curl -X POST -H 'Content-type: application/json' -d "$(jq -n --arg m "$msg" '{content: $m}')" $WEBHOOK_URL
}

if [ -f "{{ backups_secrets_file }}" ]; then
    source "{{ backups_secrets_file }}"
fi

ssh_identities=""
for ssh_key in borg_key id_ed25519 id_rsa; do
    if [ -f "{{ ansible_facts.user_dir }}/.ssh/$ssh_key" ]; then
        ssh_identities+=" -i {{ ansible_facts.user_dir }}/.ssh/$ssh_key"
    fi
done

if [ -z "$ssh_identities" ]; then
    logmsg "No SSH key found for borg backup on machine {{ ansible_hostname }}!"
    exit 1
fi

export BORG_UNKNOWN_UNENCRYPTED_REPO_ACCESS_IS_OK=yes
export BORG_RELOCATED_REPO_ACCESS_IS_OK=yes
export BORG_REPO="{{ job.value.repository }}"
export BORG_KEYS_DIR={{ ansible_facts.user_dir }}/.config/borg/keys
export BORG_RSH="ssh$ssh_identities -o StrictHostKeyChecking=no"

echo Backup job \"{{ job.key }}\" started

# systemd sends SIGTERM when RuntimeMaxSec is reached
trap 'logmsg "Backup job \"{{ job.key }}\" on {{ ansible_hostname }} was terminated (timeout?)"; exit 143' TERM

{% set dumps = job.value.dumps | default({}) %}
{% if dumps %}
dumps_dir="{{ backups_dumps_dir }}/{{ job.key }}"
{% endif %}

{% if job.value.cleanup_script is defined or dumps %}
cleanup_backup() {
    local status=$?
    trap - EXIT
{% if dumps %}
    rm -rf "$dumps_dir"
{% endif %}
{% if job.value.cleanup_script is defined %}
    (
        set -e
{{ job.value.cleanup_script }}
    ) 2>&1
    local cleanup_status=$?
    if (( status == 0 )); then
        status=$cleanup_status
    fi
{% endif %}
    exit "$status"
}
trap cleanup_backup EXIT
{% endif %}

{% if job.value.prepare_script is defined %}
(
set -e
{{ job.value.prepare_script }}
)
prepare_status=$?
if (( prepare_status != 0 )); then
    logmsg "Backup preparation failed with status $prepare_status."
    exit "$prepare_status"
fi
{% endif %}

{% if dumps %}
rm -rf "$dumps_dir"
install -d -m 700 "$dumps_dir"
{% for name, command in dumps.items() %}
if ! runuser -u {{ borg_admin_user }} -- env XDG_RUNTIME_DIR="/run/user/$(id -u {{ borg_admin_user }})" \
    bash -o pipefail -c {{ command | quote }} > "$dumps_dir/{{ name }}"; then
    logmsg "Dump {{ name }} failed on {{ ansible_hostname }}, aborting backup."
    exit 1
fi
{% endfor %}
{% endif %}

# Build find -not -path args from borg excludes file
_excl_args=()
while IFS= read -r _pat; do
    _excl_args+=(-not -path "$_pat")
done < <(grep -vE '^[#;]|^$' "{{ backups_borg_config_dir }}/{{ job.key }}.excludes.txt")

# no pipefail here is important, we want to capture find's output even
# on exit 1s
find $(cat "{{ backups_borg_config_dir }}/{{ job.key }}.paths.txt") {% if dumps %}"$dumps_dir" {% endif %}"${_excl_args[@]}" 2>/dev/null | borg create --stats --paths-from-stdin ::{{ job.value.archive }} 2>&1 | logmsg
backup_status=("${PIPESTATUS[@]}")
if (( backup_status[1] != 0 )); then
    exit "${backup_status[1]}"
fi
exit "${backup_status[2]}"
